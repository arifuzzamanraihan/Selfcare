APP_NAME="Self Care"
APP_ENV=local
APP_TIMEZONE=Asia/Dhaka

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=selfcare
DB_USERNAME=root
DB_PASSWORD=

# Vendor websites live at {slug}{TENANT_SUFFIX} on MAIN_HOST's parent domain.
# Local example (needs a wildcard hosts entry or dnsmasq):  TENANT_SUFFIX=.sc.test  MAIN_HOST=sc.test
# Production example:                                        TENANT_SUFFIX=.example.com  MAIN_HOST=selfcare.example.com
# Leave both empty to use /h/{slug} on a single host.
TENANT_SUFFIX=
MAIN_HOST=
RESERVED_SLUGS=www,app,api,admin,mail,staging,static,cdn,help,support,billing,status

# MAIL_DRIVER=log writes messages to storage/mail.log (development). MAIL_DRIVER=smtp sends for real.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="Self Care"
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASSWORD=

# Automatic HTTPS for vendor addresses (production only, needs root + acme.sh + Apache). See docs/DEPLOY.md.
SSL_AUTOMATION=0
SERVER_IP=
